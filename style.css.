/* Café Interior Room Atmosphere */
.cafe-interior {
  background: linear-gradient(180deg, #EAD9C2 0%, #D8C3A9 100%);
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.5rem;
  overflow: hidden;
  border-bottom-right-radius: 8px;
}

/* Background Room Layer Elements */
.room-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 65%;
  background-color: #3B2B24; /* Warm Victorian wood wall tone */
  border-bottom: 4px solid var(--antique-gold);
  padding: 1rem;
}

/* Arched Scenic Window */
.scenic-window {
  position: absolute;
  top: 15px;
  right: 180px;
  width: 90px;
  height: 140px;
  background: linear-gradient(135deg, #E2B2C1 0%, #C98F91 100%); /* Sunset sky tone */
  border: 4px solid var(--warm-brown);
  border-top-left-radius: 50px;
  border-top-right-radius: 50px;
  box-shadow: inset 0 0 10px rgba(0,0,0,0.3);
}

/* Pastry Display Counter Frame */
.pastry-display-case {
  position: absolute;
  bottom: -4px;
  right: 20px;
  width: 150px;
  height: 70px;
  background: rgba(255, 249, 239, 0.15);
  border: 2px solid var(--antique-gold);
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.placeholder-pastry {
  font-size: 1.5rem;
  opacity: 0.8;
}

/* Foreground Floor Area */
.cafe-floor-foreground {
  position: relative;
  z-index: 2;
  height: 80px;
  display: flex;
  align-items: center;
}
